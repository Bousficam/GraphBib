@article{kingma2014adam,
  title     = {Adam: A Method for Stochastic Optimization},
  author    = {Kingma, Diederik P and Ba, Jimmy},
  journal   = {arXiv preprint arXiv:1412.6980},
  year      = {2014},
  keywords  = {Adam, stochastic optimization, gradient descent, learning rate, momentum, neural network training},
  abstract  = {We introduce Adam, an algorithm for first-order gradient-based optimization of stochastic objective functions, based on adaptive estimates of lower-order moments. The method is straightforward to implement, computationally efficient, has little memory requirements, is invariant to diagonal rescaling of gradients, and is well suited for problems that are large in terms of data and parameters.}
}

@article{loshchilov2017sgdr,
  title     = {SGDR: Stochastic Gradient Descent with Warm Restarts},
  author    = {Loshchilov, Ilya and Hutter, Frank},
  journal   = {arXiv preprint arXiv:1608.03983},
  year      = {2017},
  keywords  = {learning rate schedule, cosine annealing, warm restarts, stochastic gradient descent, optimization},
  abstract  = {We propose a simple warm restart technique for stochastic gradient descent to improve its annealing schedule. We empirically study its properties on CIFAR-10 and CIFAR-100. Our approach achieves better performance than the standard cosine annealing schedule and enables reaching better local minima.}
}

@inproceedings{ba2016layer_norm,
  title     = {Layer Normalization},
  author    = {Ba, Jimmy Lei and Kiros, Jamie Ryan and Hinton, Geoffrey E},
  booktitle = {arXiv preprint arXiv:1607.06450},
  year      = {2016},
  keywords  = {layer normalization, batch normalization, neural network, training stability, deep learning},
  abstract  = {Training state-of-the-art deep neural networks is computationally expensive. One way to reduce the training time is to normalize the activities of the neurons. A recently introduced technique called batch normalization uses the distribution of the summed input to a neuron over a mini-batch of training cases to compute a mean and variance which are used to normalize the activity. We transpose batch normalization into layer normalization by computing the mean and variance used for normalization from all of the summed inputs to the neurons in a layer.}
}
