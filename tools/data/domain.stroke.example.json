{
  "_comment": "EXAMPLE domain pack for stroke / MI-BCI / TMS / DTI research. To activate: cp tools/data/domain.stroke.example.json tools/data/domain.json. Keep this file as a reference; edit the copy. Conventions: regions/tracts aliases are plain strings (escaped + word-boundary matched by tools); dti_metrics/outcome_scales/cohort.* values are regex fragments OR-joined raw.",
  "regions": {
    "M1": {
      "canonical": "Primary Motor Cortex (M1)",
      "aliases": ["primary motor cortex", "M1", "BA4", "Brodmann area 4", "motor cortex"]
    },
    "S1": {
      "canonical": "Primary Somatosensory Cortex (S1)",
      "aliases": ["primary somatosensory", "S1", "BA1", "BA2", "BA3", "postcentral gyrus"]
    },
    "PremotorCortex": {
      "canonical": "Premotor Cortex (PMC)",
      "aliases": ["premotor cortex", "PMC", "lateral premotor", "BA6 lateral", "dorsal premotor", "PMd", "ventral premotor", "PMv"]
    },
    "SMA": {
      "canonical": "Supplementary Motor Area (SMA)",
      "aliases": ["supplementary motor area", "SMA", "pre-SMA", "BA6 medial"]
    },
    "PosteriorParietalCortex": {
      "canonical": "Posterior Parietal Cortex",
      "aliases": ["posterior parietal", "PPC", "BA5", "BA7", "intraparietal sulcus", "IPS"]
    },
    "Cerebellum": {
      "canonical": "Cerebellum",
      "aliases": ["cerebellum", "cerebellar"]
    },
    "BasalGanglia": {
      "canonical": "Basal Ganglia",
      "aliases": ["basal ganglia", "putamen", "caudate", "globus pallidus", "striatum"]
    },
    "Thalamus": {
      "canonical": "Thalamus",
      "aliases": ["thalamus", "thalamic"]
    }
  },
  "tracts": {
    "CorticospinalTract": {
      "canonical": "Corticospinal Tract (CST)",
      "aliases": ["corticospinal tract", "corticospinal", "CST", "pyramidal tract"]
    },
    "InternalCapsule": {
      "canonical": "Internal Capsule",
      "aliases": ["internal capsule", "PLIC", "posterior limb of internal capsule", "ALIC"]
    },
    "CorpusCallosum": {
      "canonical": "Corpus Callosum",
      "aliases": ["corpus callosum", "callosal", "genu of corpus callosum", "splenium"]
    },
    "ArcuateFasciculus": {
      "canonical": "Arcuate Fasciculus",
      "aliases": ["arcuate fasciculus", "arcuate", "AF (arcuate)"]
    },
    "SuperiorLongitudinalFasciculus": {
      "canonical": "Superior Longitudinal Fasciculus (SLF)",
      "aliases": ["superior longitudinal fasciculus", "SLF", "SLF I", "SLF II", "SLF III"]
    },
    "ThalamicRadiation": {
      "canonical": "Thalamic Radiation",
      "aliases": ["thalamic radiation", "anterior thalamic radiation", "posterior thalamic radiation", "ATR", "PTR"]
    },
    "Uncinate": {
      "canonical": "Uncinate Fasciculus",
      "aliases": ["uncinate", "uncinate fasciculus"]
    }
  },
  "dti_metrics": {
    "FA": ["fa", "fractional anisotropy"],
    "MD": ["md", "mean diffusivity"],
    "AD": ["ad", "axial diffusivity"],
    "RD": ["rd", "radial diffusivity"]
  },
  "outcome_scales": {
    "FM": ["(?:Fugl[-\\s]?Meyer|FM[A-Z]?[-\\s]?(?:UE|LE|U|L)?)\\b"],
    "ARAT": ["\\bARAT\\b|Action\\s+Research\\s+Arm"],
    "BBT": ["\\bBBT\\b|Box\\s+(?:and|&)\\s+Block"],
    "NHPT": ["\\bNHPT\\b|Nine[-\\s]?Hole\\s+Peg"],
    "MEP": ["\\bMEP\\s+amplitude|motor\\s+evoked\\s+potential"],
    "MAS": ["\\bMAS\\b|Modified\\s+Ashworth"]
  },
  "cohort": {
    "chronicity": {
      "chronic": ["\\bchronic\\b|>\\s*6\\s*month|after\\s+6\\s*months"],
      "subacute": ["\\bsubacute\\b|1\\s*[-to]+\\s*6\\s*month"],
      "acute": ["\\bacute\\b|<\\s*7\\s*day|first\\s+week"]
    },
    "side": {
      "left": ["\\bleft[- ]hemispher|\\bLH\\b|\\bleft hemiparesis"],
      "right": ["\\bright[- ]hemispher|\\bRH\\b|\\bright hemiparesis"],
      "bilateral": ["\\bbilateral"]
    },
    "lesion": {
      "cortical": ["\\bcortical\\b"],
      "subcortical": ["\\bsubcortical\\b|internal\\s+capsule|deep\\s+stroke"]
    },
    "severity_scale": {
      "name": "Fugl-Meyer Upper Extremity",
      "regex": "Fugl[-\\s]?Meyer.{0,40}?(\\d{1,2})\\s*[-\u2013]\\s*(\\d{1,2})"
    }
  }
}
