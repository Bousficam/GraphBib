{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VIRTUAL_ENV": ".venv",
    "PATH": ".venv/bin:${env:PATH}"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_vault.py"
          }
        ]
      }
    ]
  }
}
