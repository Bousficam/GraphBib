__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.venv/
venv/
.cache/

# llm-wiki-agent runtime data - user content, not committed
raw/*
wiki/*
pdf2md/Split/*
.claude/settings.local.json

# Extraction projects - per-user analytical artifacts.
# If you want to commit a project's spec (contexte/instructions/template)
# while excluding output/articles, unignore selectively in a sub-.gitignore.
project-review/*

# Local toolchain / large downloads - never part of the repo
node-v26.4.0/

# Derived views and operational byproducts of the vault (vault itself is
# already ignored above); regenerable, and large.
graph/
.maintenance/

# Stray analysis figures - these belong to the Stats project, not here
*.png

# Local credentials - loaded by tools/_lib.py, never committed
.env
# ...and every variant (.env.local, .env.bak-*, .env.save): these hold
# credentials and a bare `.env` line does not match them.
.env*
